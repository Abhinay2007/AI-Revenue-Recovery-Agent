APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://revenue_user:revenue_password@postgres:5432/revenue_recovery
DATASET_PATH=
# Supported providers: ollama, local, openai, groq
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:latest
LLM_API_KEY=
MAX_AGENT_STEPS=8
LLM_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_BASE_URL=http://localhost:11434
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_REQUEST_TIMEOUT_SECONDS=10
RAZORPAY_TEST_ORDER_ID=
